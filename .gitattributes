# Empêche Git de convertir les fins de ligne :
# un .sh en CRLF ne démarre pas, un .bat en LF se lit mal.
*.sh   text eol=lf
*.bat  text eol=crlf
*.js   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf

# Les scripts PowerShell doivent garder des fins de ligne Windows
*.ps1 text eol=crlf
